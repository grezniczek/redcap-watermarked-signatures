{
    "name": "Watermarked Signatures",
    "tt_name": "config_module_name",
    "namespace": "DE\\RUB\\WatermarkedSignaturesExternalModule",
    "description": "A REDCap external module that adds watermarks to signatures.",
    "tt_description": "config_module_description",
    "documentation": "config_readme",
    "tt_documentation": true,
    "authors": [
        {
            "name": "Günther Rezniczek",
            "email": "guenther.rezniczek@rub.de",
            "institution": "St. Elisabeth Gruppe - Klinikum der Ruhr-Universität Bochum"
        }
    ],
    "framework-version": 16,
    "enable-no-auth-logging": true,
    "auth-ajax-actions": [
        "validate-project-settings"
    ],
    "links": {
        "control-center": [
            {
                "name": "Administrator signature verification",
                "tt_name": "config_administrator_verification_link",
                "key": "administrator-signature-verification",
                "icon": "fa-solid fa-shield-halved",
                "url": "pages/admin-verify-signature.php",
                "show-header-and-footer": true
            }
        ],
        "project": [
            {
                "name": "Configure Watermarked Signatures",
                "tt_name": "config_project_settings_link",
                "key": "project-settings",
                "icon": "fa-solid fa-sliders",
                "url": "pages/project-settings.php",
                "show-header-and-footer": true
            },
            {
                "name": "Verify watermarked signature",
                "tt_name": "config_project_verification_link",
                "key": "signature-verification",
                "icon": "fa-solid fa-shield-halved",
                "url": "pages/verify-signature.php",
                "show-header-and-footer": true
            }
        ]
    },
    "action-tags": [
        {
            "tag": "@WATERMARKED-SIGNATURE",
            "description": "config_at_watermarked_signature",
            "tt_description": true
        }
    ],
    "system-settings": [
    ],
    "project-settings": [
        {
            "key": "unbound-upload-retention-days",
            "name": "Retain unbound signature-upload provenance for this many days (0 disables automatic purging)",
            "tt_name": "config_unbound_upload_retention_days",
            "type": "text",
            "default": "90",
            "hidden": true
        },
        {
            "key": "public-project-reference",
            "name": "Public project reference printed as REF: on every new watermarked signature (optional; 1–30 ASCII letters, digits, spaces, dots, hyphens, underscores, or slashes). This is visible on exported images and should not reveal sensitive project information.",
            "tt_name": "config_public_project_reference",
            "type": "text",
            "hidden": true
        },
        {
            "key": "background-image-mode",
            "name": "Signature background image",
            "tt_name": "config_background_image_mode",
            "type": "radio",
            "default": "redcap",
            "hidden": true,
            "choices": [
                {
                    "value": "redcap",
                    "name": "Use the REDCap logo",
                    "tt_name": "config_background_image_mode_redcap"
                },
                {
                    "value": "custom",
                    "name": "Use the custom image",
                    "tt_name": "config_background_image_mode_custom"
                },
                {
                    "value": "none",
                    "name": "Do not use a background image",
                    "tt_name": "config_background_image_mode_none"
                }
            ]
        },
        {
            "key": "custom-background-image",
            "name": "Custom signature background image (PNG, 16–512 pixels per side, at most 1 MiB; retained even when not selected)",
            "tt_name": "config_custom_background_image",
            "type": "file",
            "required": false,
            "hidden": true
        },
        {
            "key": "background-image-rotation",
            "name": "Custom signature background image rotation in degrees (-180 to 180)",
            "tt_name": "config_background_image_rotation",
            "type": "text",
            "default": "20",
            "hidden": true
        },
        {
            "key": "javascript-debug",
            "name": "config_javascript_debug",
            "tt_name": true,
            "type": "checkbox"
        }
    ],
    "crons": [
        {
            "cron_name": "purge-unbound-signature-uploads",
            "cron_description": "Purge expired, unbound signature upload provenance",
            "tt_cron_description": "config_cron_purge_unbound_uploads",
            "method": "cron_purge_unbound_upload_provenance",
            "cron_frequency": 86400,
            "cron_max_run_time": 300
        }
    ]
}
